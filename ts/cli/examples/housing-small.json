{
  "prefix": "hs:",
  "nodes": [
    {
      "key": "reader",
      "alias": "csv-reader",
      "settings": {
        "source.path.path": "${HOUSING_CSV:-/Users/benbryant/knime-workspace/knime-cli-demo/california-housing/housing.csv}"
      }
    },
    {
      "key": "missing",
      "alias": "missing-value",
      "settings": {
        "dataTypeSettings": {
          "org.knime.core.data.def.DoubleCell": {
            "factoryID": "org.knime.base.node.preproc.pmml.missingval.handlers.MedianNumberMissingCellHandlerFactory"
          }
        }
      }
    },
    {
      "key": "partition",
      "alias": "partition",
      "settings": { "partitioningMode": "RELATIVE", "percentage": 80, "mode": "RANDOM", "seed": 42, "seed_is_present": true }
    },
    {
      "key": "learn",
      "alias": "linreg-learn",
      "settings": {
        "target": "median_house_value",
        "column_filter": { "included_names": [], "excluded_names": ["ocean_proximity", "median_house_value"] }
      }
    },
    {
      "key": "predict",
      "alias": "reg-predict",
      "settings": { "has_custom_predicition_name": true, "custom_prediction_name": "pred_linear" }
    },
    {
      "key": "score",
      "alias": "numeric-scorer",
      "settings": {
        "reference": { "useRowID": false, "columnName": "median_house_value" },
        "predicted": { "useRowID": false, "columnName": "pred_linear" }
      }
    },
    {
      "key": "rf-learn",
      "alias": "rf-learn",
      "preset": { "name": "regression", "target": "median_house_value", "exclude": ["ocean_proximity"] },
      "settings": { "nrModels": 100 }
    },
    {
      "key": "rf-predict",
      "alias": "rf-predict",
      "preset": { "name": "named", "column": "pred_rf" }
    },
    {
      "key": "rf-score",
      "alias": "numeric-scorer",
      "settings": {
        "reference": { "useRowID": false, "columnName": "median_house_value" },
        "predicted": { "useRowID": false, "columnName": "pred_rf" }
      }
    }
  ],
  "connections": [
    { "from": "reader:1", "to": "missing:1" },
    { "from": "missing:1", "to": "partition:1" },
    { "from": "partition:1", "to": "learn:1" },
    { "from": "learn:1", "to": "predict:1" },
    { "from": "partition:2", "to": "predict:2" },
    { "from": "predict:1", "to": "score:1" },
    { "from": "partition:1", "to": "rf-learn:1" },
    { "from": "rf-learn:3", "to": "rf-predict:1" },
    { "from": "partition:2", "to": "rf-predict:2" },
    { "from": "rf-predict:1", "to": "rf-score:1" }
  ],
  "run": ["score", "rf-score"]
}
